<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:element name="coffeeMachines">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="coffeeMachine" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="type" type="machineType"/>
              <xs:element name="model" type="xs:string"/>
              <xs:element name="powerWatts" type="xs:nonNegativeInteger"/>
              <xs:element name="pressureBar" type="xs:decimal"/>
              <xs:element name="waterTankMl" type="xs:nonNegativeInteger"/>
              <xs:element name="cupsPerCycle" type="xs:nonNegativeInteger"/>
              <xs:element name="manufactureDate" type="xs:string"/>
              <xs:element name="price" type="xs:decimal"/>
              <xs:element name="manufacturer" type="xs:string"/>
              <xs:element name="color" type="xs:string"/>
              <xs:element name="warrantyMonths" type="xs:nonNegativeInteger"/>
            </xs:sequence>
            <xs:attribute name="id" type="xs:positiveInteger" use="required"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:simpleType name="machineType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="ESPRESSO"/>
      <xs:enumeration value="DRIP"/>
      <xs:enumeration value="CAPSULE"/>
      <xs:enumeration value="AUTOMATIC"/>
      <xs:enumeration value="MOKA"/>
      <xs:enumeration value="POD"/>
    </xs:restriction>
  </xs:simpleType>
</xs:schema>
